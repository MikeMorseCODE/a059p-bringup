# Maintainer: TODO <todo@example.com>
# FIXME: replace the maintainer line before submitting; pmaports requires a
# real name and address. Everything else in this aport is generated by
# `make apk`, which fills in pkgver and sha512sums from the actual tree.

pkgname=asteroids-port-tools
pkgver=@PKGVER@
pkgrel=0
pkgdesc="Bring-up tooling for postmarketOS on the Nothing Phone (3a) Pro (A059P)"
url="https://nura.eco"
arch="noarch"
license="MIT"
depends="python3 mtools dosfstools"
makedepends="make"
checkdepends="python3 mtools dosfstools"
source="$pkgname-$pkgver.tar.gz"
builddir="$srcdir/$pkgname-$pkgver"
options="!strip"

# The tools are shell and python; there is nothing to compile.
build() {
	:
}

# The regression suite runs the whole pipeline against stubs. It only needs
# python3 plus mtools/dosfstools, and it skips the payload half without them
# rather than failing, so it is safe in a chroot.
check() {
	cd "$builddir"
	make check
	make test
}

package() {
	cd "$builddir"
	make install DESTDIR="$pkgdir" PREFIX=/usr
}

sha512sums="
@SHA512@  @TARBALL@
"
